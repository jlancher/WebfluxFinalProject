<?xml version="1.0" encoding="UTF-8"?>
<!--
  Copiar a:  %USERPROFILE%\.m2\settings.xml
  (Si ya tienes settings.xml, fusiona solo la sección <mirrors>.)

  Objetivo: que Maven NO use https://repo.maven.apache.org (PKIX en red corporativa)
  y resuelva parent, BOMs (neo4j, spring-boot, etc.) vía Artifactory.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0
          https://maven.apache.org/xsd/settings-1.2.0.xsd">

  <mirrors>
    <mirror>
      <id>bancolombia-artifactory</id>
      <mirrorOf>central</mirrorOf>
      <url>https://artifactory.apps.bancolombia.com/maven-bancolombia/</url>
    </mirror>
  </mirrors>

  <!-- Si el curso entrega usuario/token, descomenta y completa:
  <servers>
    <server>
      <id>bancolombia-artifactory</id>
      <username>TU_USUARIO</username>
      <password>TU_TOKEN</password>
    </server>
  </servers>
  -->
</settings>